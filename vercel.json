{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PUBLIC_SITE_URL": "https://www.tukiviagens.com.br"
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logotipo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/destinos/olimpia",
      "destination": "/olimpia/",
      "permanent": true
    },
    {
      "source": "/destinos/olimpia/",
      "destination": "/olimpia/",
      "permanent": true
    }
  ]
}
