---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { resolvePageGalleryImages } from '../lib/property-gallery';
import { slugToPath } from '../lib/site-routes';

export async function getStaticPaths() {
	const entries = await getCollection('paginas');
	return entries.map((entry) => ({
		params: { path: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { seo, ...data } = entry.data;
const pagePath = slugToPath(entry.id);

const galleryImages = resolvePageGalleryImages({
	entryId: entry.id,
	pageType: data.pageType,
	explicitImages: data.images,
	label: data.title,
});
const seoImage = galleryImages[0]?.src ?? seo.image;
---

<PageLayout
	title={seo.title}
	description={seo.description}
	path={pagePath}
	pageType={data.pageType}
	headline={data.headline}
	pageTitle={data.title}
	highlights={data.highlights}
	faq={data.faq}
	whatsapp={data.whatsapp}
	cta={data.cta}
	image={seoImage}
	galleryImages={galleryImages}
>
	<Content />
</PageLayout>
