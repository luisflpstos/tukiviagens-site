---
import '../styles/global.css';
import Seo from '../components/common/Seo.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import DeferredAnalytics from '../components/common/DeferredAnalytics.astro';
import LeadTracker from '../components/common/LeadTracker.astro';
import { BRAND } from '../lib/constants';
import type { SeoProps } from '../lib/seo';
import Analytics from '@vercel/analytics/astro';
import { resolveHeroImagePath } from '../lib/image-paths';
import { resolveMascotImagePath } from '../lib/mascot-paths';

interface Props extends SeoProps {
	showHeader?: boolean;
	showFooter?: boolean;
	/** Inclui o Kortex Lead Tracker antes de </body> (páginas com formulário). */
	includeLeadTracker?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	path = '/',
	image,
	noindex = false,
	type = 'website',
	showHeader = true,
	showFooter = true,
	includeLeadTracker = false,
	jsonLd,
} = Astro.props;

const isHome = path === '/' || path === '';
const homeHeroPreload = isHome ? resolveHeroImagePath() : undefined;
const homeMascotPreload = isHome ? resolveMascotImagePath(BRAND.mascot.hero) : undefined;
const fontStylesheet =
	'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@700;800;900&display=swap';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={BRAND.faviconSvg} />
		<link rel="icon" href={BRAND.favicon} sizes="32x32" />
		<link rel="apple-touch-icon" href={BRAND.appleTouchIcon} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{
			homeHeroPreload && (
				<link rel="preload" as="image" href={homeHeroPreload} fetchpriority="high" />
			)
		}
		{
			homeMascotPreload && (
				<link rel="preload" as="image" href={homeMascotPreload} fetchpriority="high" />
			)
		}
		<link
			href={fontStylesheet}
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link href={fontStylesheet} rel="stylesheet" />
		</noscript>
		<Seo title={title} description={description} path={path} image={image} noindex={noindex} type={type} jsonLd={jsonLd} />
	</head>
	<body>
		<DeferredAnalytics />
		{showHeader && <Header />}
		<main>
			<slot />
		</main>
		{showFooter && <Footer />}

		{includeLeadTracker && <LeadTracker />}

		<script>
			import { captureUtmParams } from '../scripts/utm';
			import { observeWhatsAppLinks } from '../scripts/whatsapp-click';
			captureUtmParams();
			observeWhatsAppLinks();
		</script>
	</body>
</html>
<Analytics />
