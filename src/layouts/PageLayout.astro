---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import ContentWithCarousel from '../components/sections/ContentWithCarousel.astro';
import Faq from '../components/sections/Faq.astro';
import LeadCaptureSection from '../components/sections/LeadCaptureSection.astro';
import PageHero from '../components/sections/PageHero.astro';
import { type GalleryImage } from '../lib/gallery-images';
import { isHospitalityPage } from '../lib/hospitality';
import { shouldShowPageCarousel } from '../lib/property-gallery';
import { buildCanonical } from '../lib/seo';
import { resolveLeadDestination } from '../lib/lead-destination';
import { getChildRoutes, getRouteByPath, normalizePath } from '../lib/site-routes';

interface RelatedPage {
	label: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	path: string;
	pageType: 'hub' | 'venda' | 'atracao' | 'hotel' | 'resort' | 'institucional';
	headline: string;
	pageTitle?: string;
	highlights: string[];
	faq: { question: string; answer: string }[];
	whatsapp: string;
	cta: string;
	image?: string;
	relatedPages?: RelatedPage[];
	galleryImages?: GalleryImage[];
}

const {
	title,
	description,
	path,
	pageType,
	headline,
	pageTitle = title,
	highlights,
	faq,
	whatsapp,
	cta,
	image,
	relatedPages = [],
	galleryImages = [],
} = Astro.props;

const showGallery = shouldShowPageCarousel(pageType, galleryImages);
const currentRoute = getRouteByPath(path);
const parentRoute = currentRoute?.parent ? getRouteByPath(currentRoute.parent) : undefined;
const destinationHubRoute =
	parentRoute?.pageType === 'hub'
		? parentRoute
		: parentRoute?.parent
			? getRouteByPath(parentRoute.parent)
			: undefined;

const pageTypeLabels: Record<Props['pageType'], string> = {
	hub: 'Destino',
	venda: 'Hospedagem',
	atracao: 'Atração',
	hotel: 'Hotel',
	resort: 'Resort',
	institucional: 'Tuki Viagens',
};

const childRoutes = getChildRoutes(path)
	.filter((route) => route.status === 'published')
	.map((route) => ({
		label: route.title,
		href: route.path,
	}));

const navPages = relatedPages.length > 0 ? relatedPages : childRoutes;

const breadcrumbItems = [
	{ name: 'Início', path: '/' },
	...(destinationHubRoute ? [{ name: destinationHubRoute.title, path: destinationHubRoute.path }] : []),
	...(parentRoute && parentRoute.pageType !== 'hub'
		? [{ name: parentRoute.title, path: parentRoute.path }]
		: []),
	...(path !== '/' ? [{ name: pageTitle, path }] : []),
];

const structuredPage =
	isHospitalityPage(pageType)
		? {
				'@context': 'https://schema.org',
				'@type': 'Hotel',
				name: title,
				description,
				url: buildCanonical(path),
			}
		: pageType === 'atracao'
			? {
					'@context': 'https://schema.org',
					'@type': 'TouristAttraction',
					name: title,
					description,
					url: buildCanonical(path),
				}
			: null;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbItems.map((item, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: item.name,
			item: buildCanonical(item.path),
		})),
	},
	...(structuredPage ? [structuredPage] : []),
	...(faq.length > 0
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'FAQPage',
					mainEntity: faq.map((item) => ({
						'@type': 'Question',
						name: item.question,
						acceptedAnswer: {
							'@type': 'Answer',
							text: item.answer,
						},
					})),
				},
			]
		: []),
];

const benefitsTitle =
	pageType === 'hotel'
		? 'Destaques do hotel'
		: pageType === 'resort'
			? 'Destaques do resort'
			: pageType === 'atracao'
				? 'Destaques'
				: 'Destaques';

const leadTitle =
	isHospitalityPage(pageType)
		? 'Consulte hospedagem'
		: pageType === 'atracao'
			? 'Cotar hospedagem no destino'
			: 'Peça sua cotação';

const leadDestination =
	resolveLeadDestination({ path, silo: currentRoute?.silo }) ??
	resolveLeadDestination({ fallback: destinationHubRoute?.title }) ??
	title;
---

<BaseLayout title={title} description={description} path={path} image={image} jsonLd={jsonLd} includeLeadTracker>
	<div id="conteudo">
	<PageHero image={image}>
			<nav aria-label="Breadcrumb" class="tuki-type-small text-white/70">
				<ol class="flex flex-wrap items-center gap-2">
					{breadcrumbItems.map((item, index) => (
						<>
							{index > 0 && <li aria-hidden="true">/</li>}
							<li>
								{index === breadcrumbItems.length - 1 ? (
									<span class="text-white">{item.name}</span>
								) : (
									<a href={normalizePath(item.path)} class="hover:text-white">
										{item.name}
									</a>
								)}
							</li>
						</>
					))}
				</ol>
			</nav>
			<p class="tuki-eyebrow-light mt-4">{pageTypeLabels[pageType]}</p>
			<h1 class="tuki-type-display mt-2">{headline}</h1>
			<p class="tuki-type-lead tuki-type-inverse tuki-measure mt-4 max-w-2xl text-white/90">{description}</p>
			<Button
				whatsappPhone={whatsapp}
				whatsappProduct={title}
				whatsappH1={headline}
				variant="primary"
				size="lg"
				class="mt-8"
				target="_blank"
				rel="noopener noreferrer"
			>
				{cta}
			</Button>
	</PageHero>

	{
		navPages.length > 0 && (
			<section class="border-b border-tuki-purple/8 bg-tuki-lavender/50 py-8">
				<Container>
					<h2 class="tuki-type-title text-tuki-ink">Neste destino</h2>
					<div class="mt-4 flex flex-wrap gap-3">
						{navPages.map((page) => (
							<a
								href={normalizePath(page.href)}
								class="tuki-type-small rounded-full bg-white px-4 py-2 font-medium text-tuki-purple shadow-sm transition hover:bg-tuki-purple/5"
							>
								{page.label}
							</a>
						))}
					</div>
				</Container>
			</section>
		)
	}

	<article class:list={[!showGallery && 'section-padding']}>
		{
			showGallery ? (
				<ContentWithCarousel images={galleryImages} label={title}>
					<slot />
				</ContentWithCarousel>
			) : (
				<Container size="narrow">
					<div class="content-markdown max-w-none">
						<slot />
					</div>
				</Container>
			)
		}
	</article>

	{highlights.length > 0 && <BenefitsList items={highlights} title={benefitsTitle} />}
	<Faq items={faq} />
	<LeadCaptureSection
		formId="pagina-lead-form"
		hotel={isHospitalityPage(pageType) ? title : undefined}
		destination={leadDestination}
		title={leadTitle}
		subtitle={
			isHospitalityPage(pageType)
				? `${title} · ${leadDestination}`
				: 'Preencha o formulário e nossa equipe retorna rapidamente.'
		}
	/>
	</div>
</BaseLayout>
