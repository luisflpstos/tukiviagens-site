---
import Container from '../common/Container.astro';
import LeadForm from '../common/LeadForm.astro';
import { getLeadCaptureSectionAssets } from '../../lib/lead-capture-section';

interface Props {
	title?: string;
	subtitle?: string;
	formId?: string;
	hotel?: string;
	resort?: string;
	destination?: string;
	campaign?: string;
}

const {
	title = 'Consulte disponibilidade',
	subtitle = 'Preencha o formulário e nossa equipe retorna rapidamente.',
	formId = 'lead-capture-form',
	hotel,
	resort,
	destination,
	campaign,
} = Astro.props;

const { mascotSrc, mascotAlt } = getLeadCaptureSectionAssets();
---

<section id="formulario" class="section-padding overflow-visible bg-white">
	<Container size="default" class="overflow-visible">
		<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,32rem)] lg:gap-14">
			<div class="tuki-surface-panel order-2 min-w-0 lg:order-1">
				<h2 class="tuki-type-headline text-tuki-ink">{title}</h2>
				<p class="tuki-type-body mt-2 text-tuki-muted">{subtitle}</p>
				<div class="mt-8">
					<LeadForm
						formId={formId}
						hotel={hotel}
						resort={resort}
						destination={destination}
						campaign={campaign}
						submitLabel="Consultar disponibilidade"
					/>
				</div>
			</div>

			<figure class="relative order-1 mx-auto flex w-full max-w-md justify-center lg:sticky lg:top-28 lg:order-2 lg:mx-0 lg:max-w-none lg:justify-end">
				<img
					src={mascotSrc}
					alt={mascotAlt}
					class="tuki-mascot-glide pointer-events-none h-auto w-full max-w-[24rem] object-contain drop-shadow-2xl sm:max-w-[28rem] lg:max-w-none lg:w-full"
					width={512}
					height={508}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</Container>
</section>
