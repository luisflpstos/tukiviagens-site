---
import Container from '../common/Container.astro';
import LeadForm from '../common/LeadForm.astro';
import { getLeadCaptureSectionAssets } from '../../lib/lead-capture-section';

interface Props {
	title?: string;
	subtitle?: string;
	formId?: string;
	hotel?: string;
	resort?: string;
	destination?: string;
	campaign?: string;
}

const {
	title = 'Consulte disponibilidade',
	subtitle = 'Preencha o formulário e nossa equipe retorna rapidamente.',
	formId = 'lead-capture-form',
	hotel,
	resort,
	destination,
	campaign,
} = Astro.props;

const { mascotSrc, mascotAlt } = getLeadCaptureSectionAssets();
---

<section id="formulario" class="section-padding overflow-visible bg-white">
	<Container size="default" class="overflow-visible">
		<div class="relative ml-auto w-full max-w-xl overflow-visible lg:max-w-2xl">
			<figure
				class="pointer-events-none absolute top-1/2 left-0 z-20 hidden -translate-x-[93%] -translate-y-1/2 sm:block"
			>
				<img
					src={mascotSrc}
					alt={mascotAlt}
					class="tuki-mascot-glide h-[34rem] w-auto max-w-[30rem] object-contain drop-shadow-2xl md:h-[40rem] md:max-w-[34rem] lg:h-[46rem] lg:max-w-[38rem]"
					width={608}
					height={604}
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="tuki-surface-panel relative z-10">
				<h2 class="tuki-type-headline text-tuki-ink">{title}</h2>
				<p class="tuki-type-body mt-2 text-tuki-muted">{subtitle}</p>
				<div class="mt-8">
					<LeadForm
						formId={formId}
						hotel={hotel}
						resort={resort}
						destination={destination}
						campaign={campaign}
						submitLabel="Consultar disponibilidade"
					/>
				</div>
			</div>
		</div>
	</Container>
</section>
