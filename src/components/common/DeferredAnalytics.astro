---
/**
 * Boots GTM / GA4 / Google Ads / Meta Pixel after idle so they stay off the LCP path.
 * Noscript fallbacks remain for users without JS.
 */
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID as string | undefined;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;

const enabled = Boolean(gtmId || ga4Id || googleAdsId || metaPixelId);
---

{
	enabled && (
		<script>
			import { scheduleIdle, IDLE_ANALYTICS_TIMEOUT_MS } from '../../lib/schedule-idle';
			import { bootAnalytics, type AnalyticsConfig } from '../../scripts/boot-analytics';

			const config = {
				gtmId: import.meta.env.PUBLIC_GTM_ID || undefined,
				ga4Id: import.meta.env.PUBLIC_GA4_ID || undefined,
				googleAdsId: import.meta.env.PUBLIC_GOOGLE_ADS_ID || undefined,
				metaPixelId: import.meta.env.PUBLIC_META_PIXEL_ID || undefined,
			} satisfies AnalyticsConfig;

			scheduleIdle(() => bootAnalytics(config), undefined, IDLE_ANALYTICS_TIMEOUT_MS);
		</script>
	)
}

{
	gtmId && (
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"
				title="Google Tag Manager"
			/>
		</noscript>
	)
}

{
	metaPixelId && (
		<noscript>
			<img
				height="1"
				width="1"
				style="display:none"
				src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
				alt=""
			/>
		</noscript>
	)
}
