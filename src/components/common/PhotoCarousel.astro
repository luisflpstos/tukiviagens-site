---
interface Props {
	images: { src: string; alt: string }[];
	label: string;
}

const { images, label } = Astro.props;
---

{
	images.length > 0 && (
		<div
			class="photo-carousel"
			data-photo-carousel
			aria-roledescription="carrossel"
			aria-label={`Fotos de ${label}`}
		>
			<div class="relative overflow-hidden rounded-2xl bg-tuki-lavender shadow-[0_18px_40px_color-mix(in_srgb,var(--color-tuki-purple)_12%,transparent)]">
				<div class="aspect-[4/3]">
					<div
						class="flex h-full transition-transform duration-500 ease-out"
						data-carousel-track
						aria-live="polite"
					>
						{images.map((image, index) => (
							<figure
								class="h-full w-full shrink-0"
								data-carousel-slide={index}
								aria-roledescription="slide"
							>
								<button
									type="button"
									class="group h-full w-full cursor-zoom-in"
									data-carousel-open-lightbox
									aria-label={`Ampliar foto: ${image.alt}`}
								>
									<img
										src={image.src}
										alt={image.alt}
										class="h-full w-full object-cover transition group-hover:brightness-95"
										loading="lazy"
										decoding="async"
									/>
								</button>
							</figure>
						))}
					</div>
				</div>
			</div>

			{images.length > 1 && (
				<div class="mt-4 flex items-center justify-center gap-3">
					<button
						type="button"
						class="flex h-9 w-9 items-center justify-center rounded-full border border-tuki-purple/15 bg-white text-tuki-purple transition hover:border-tuki-purple/30 hover:bg-tuki-purple/5"
						data-carousel-prev
						aria-label="Foto anterior"
					>
						<span aria-hidden="true">‹</span>
					</button>

					<div class="flex gap-2" data-carousel-dots>
						{images.map((_, index) => (
							<button
								type="button"
								class:list={[
									'h-2.5 w-2.5 rounded-full transition',
									index === 0 ? 'bg-tuki-purple' : 'bg-tuki-purple/25 hover:bg-tuki-purple/40',
								]}
								data-carousel-dot={index}
								aria-label={`Ir para foto ${index + 1}`}
								aria-current={index === 0 ? 'true' : undefined}
							/>
						))}
					</div>

					<button
						type="button"
						class="flex h-9 w-9 items-center justify-center rounded-full border border-tuki-purple/15 bg-white text-tuki-purple transition hover:border-tuki-purple/30 hover:bg-tuki-purple/5"
						data-carousel-next
						aria-label="Próxima foto"
					>
						<span aria-hidden="true">›</span>
					</button>
				</div>
			)}

			<div
				class="photo-lightbox fixed inset-0 z-[100] hidden"
				data-photo-lightbox
				role="dialog"
				aria-modal="true"
				aria-label={`Galeria ampliada de ${label}`}
				aria-hidden="true"
			>
				<div
					class="photo-lightbox__backdrop absolute inset-0 bg-black/88"
					data-lightbox-backdrop
				/>

				<button
					type="button"
					class="pointer-events-auto absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl leading-none text-white transition hover:bg-white/20"
					data-lightbox-close
					aria-label="Fechar galeria"
				>
					<span aria-hidden="true">×</span>
				</button>

				<div class="pointer-events-none relative z-[1] h-full w-full overflow-hidden px-4 py-14 sm:px-10">
					<div
						class="pointer-events-auto flex h-full w-full cursor-grab touch-none active:cursor-grabbing"
						data-lightbox-track
					>
						{images.map((image) => (
							<figure
								class="flex h-full w-full shrink-0 items-center justify-center"
								data-lightbox-slide
							>
								<img
									src={image.src}
									alt={image.alt}
									class="max-h-[calc(100vh-7rem)] max-w-[min(100vw-2rem,100%)] h-auto w-auto object-contain select-none"
									draggable="false"
									decoding="async"
								/>
							</figure>
						))}
					</div>

					{images.length > 1 && (
						<>
							<button
								type="button"
								class="pointer-events-auto absolute top-1/2 left-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/20 sm:left-4"
								data-lightbox-prev
								aria-label="Foto anterior"
							>
								<span aria-hidden="true">‹</span>
							</button>
							<button
								type="button"
								class="pointer-events-auto absolute top-1/2 right-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/20 sm:right-4"
								data-lightbox-next
								aria-label="Próxima foto"
							>
								<span aria-hidden="true">›</span>
							</button>
						</>
					)}
				</div>
			</div>
		</div>
	)
}

<script>
	import '../../scripts/photo-carousel';
</script>
