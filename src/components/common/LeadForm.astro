---
import { LEAD_FIELD_MAX_LENGTH, MAX_ADULTS, MAX_CHILDREN } from '../../lib/lead-config';
import { LEAD_PHONE_FIELD_NAME } from '../../scripts/lead-form-fields';
import LeadDateRangePicker from './LeadDateRangePicker.astro';

interface Props {
	formId?: string;
	hotel?: string;
	resort?: string;
	destination?: string;
	campaign?: string;
	submitLabel?: string;
}

const {
	formId = 'lead-form',
	hotel,
	resort,
	destination,
	campaign,
	submitLabel = 'Enviar',
} = Astro.props;

const adultOptions = Array.from({ length: MAX_ADULTS }, (_, index) => index + 1);
const childOptions = Array.from({ length: MAX_CHILDREN + 1 }, (_, index) => index);
---

<form
	id={formId}
	class="space-y-4"
	novalidate
	data-lead-form
	data-hotel={hotel}
	data-resort={resort}
	data-destination={destination}
	data-campaign={campaign}
>
	<div class="grid gap-4 sm:grid-cols-2">
		<div class="sm:col-span-2">
			<label for={`${formId}-nome`} class="tuki-type-small mb-1 block font-medium text-tuki-ink">
				Nome completo *
			</label>
			<input
				id={`${formId}-nome`}
				name="nome"
				type="text"
				required
				maxlength={LEAD_FIELD_MAX_LENGTH}
				autocomplete="name"
				class="w-full tuki-input"
				placeholder="Seu nome completo"
			/>
		</div>

		<div>
			<label for={`${formId}-telefone`} class="tuki-type-small mb-1 block font-medium text-tuki-ink">
				Telefone (WhatsApp) *
			</label>
			<input
				id={`${formId}-telefone`}
				name={LEAD_PHONE_FIELD_NAME}
				type="tel"
				required
				maxlength={LEAD_FIELD_MAX_LENGTH}
				autocomplete="tel"
				class="w-full tuki-input"
				placeholder="(00) 00000-0000"
			/>
		</div>

		<div>
			<label for={`${formId}-email`} class="tuki-type-small mb-1 block font-medium text-tuki-ink">
				E-mail *
			</label>
			<input
				id={`${formId}-email`}
				name="email"
				type="email"
				required
				maxlength={LEAD_FIELD_MAX_LENGTH}
				autocomplete="email"
				class="w-full tuki-input"
				placeholder="seu@email.com"
			/>
		</div>

		<LeadDateRangePicker formId={formId} />

		<div>
			<label for={`${formId}-adultos`} class="tuki-type-small mb-1 block font-medium text-tuki-ink">
				Adultos *
			</label>
			<select id={`${formId}-adultos`} name="adultos" required class="tuki-input tuki-select">
				<option value="" disabled selected>Selecione</option>
				{adultOptions.map((count) => (
					<option value={count}>
						{count} {count === 1 ? 'adulto' : 'adultos'}
					</option>
				))}
			</select>
		</div>

		<div>
			<label for={`${formId}-criancas`} class="tuki-type-small mb-1 block font-medium text-tuki-ink">
				Crianças (até 12 anos) *
			</label>
			<select id={`${formId}-criancas`} name="criancas" required class="tuki-input tuki-select">
				{childOptions.map((count) => (
					<option value={count} selected={count === 0}>
						{count === 0 ? 'Nenhuma criança' : `${count} ${count === 1 ? 'criança' : 'crianças'}`}
					</option>
				))}
			</select>
		</div>
	</div>

	<div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
		<label for={`${formId}-hp`}>Não preencha este campo</label>
		<input id={`${formId}-hp`} name="_hp" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button
		type="submit"
		data-default-label={submitLabel}
		class="w-full rounded-full bg-tuki-orange-button px-6 py-3 font-semibold text-white transition hover:bg-tuki-orange-dark disabled:opacity-60"
	>
		{submitLabel}
	</button>

	<p data-form-status class="tuki-type-small min-h-5 text-center" role="status" aria-live="polite"></p>
</form>

<script>
	import { initLeadForm } from '../../scripts/lead-form';

	document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
		initLeadForm({
			formId: form.id,
			variant: form.dataset.leadFormVariant === 'compact' ? 'compact' : 'full',
			hotel: form.dataset.hotel,
			resort: form.dataset.resort,
			destination: form.dataset.destination,
			campaign: form.dataset.campaign,
		});
	});
</script>
