PUBLIC_SITE_URL=https://seudominio.com.br
# Endpoint externo que recebe os leads (somente servidor — não expor no frontend)
LEAD_WEBHOOK_URL=https://flow-webhook-prd.kortex.app.br/webhook/olimtour/campanhas
# Opcional: token Bearer enviado ao webhook
LEAD_WEBHOOK_SECRET=
PUBLIC_WHATSAPP_WEBHOOK_URL=https://flow-webhook-prd.kortex.app.br/webhook/olimtour/campanhas
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GA4_ID=G-40VZ9X9TL0
# Google Ads — conversões via gtag (opcional)
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
# Alternativa: send_to completo (AW-xxx/label) sobrescreve id+label acima
# PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=AW-XXXXXXXXX/lead-label
# PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-XXXXXXXXX/whatsapp-label
# Bloqueia indexação em buscadores. Defina como false quando o site estiver pronto para SEO.
PUBLIC_BLOCK_INDEXING=false
