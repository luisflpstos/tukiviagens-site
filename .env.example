# Local: http://localhost:4321 | Produção (Vercel): https://www.tukiviagens.com.br
PUBLIC_SITE_URL=http://localhost:4321
# Webhook WhatsApp (fallback). Formulários NÃO usam isto — só lead-tracker.js do Kortex.
# Nunca commite a URL real: ela permite postar direto no CRM.
LEAD_WEBHOOK_URL=https://webhook.exemplo.com/lead
# Bearer enviado ao webhook WhatsApp. Configure o webhook para recusar chamadas sem ele.
LEAD_WEBHOOK_SECRET=
# Webhook para cliques WhatsApp (somente servidor; fallback: LEAD_WEBHOOK_URL).
# Substitui PUBLIC_WHATSAPP_WEBHOOK_URL (legado — o prefixo PUBLIC_ expõe o valor ao browser).
WHATSAPP_WEBHOOK_URL=https://webhook.exemplo.com/whatsapp-click
PUBLIC_GTM_ID=GTM-M3LNVPXZ
PUBLIC_GA4_ID=G-40VZ9X9TL0
# Google Ads — conversões via gtag (opcional)
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
# Alternativa: send_to completo (AW-xxx/label) sobrescreve id+label acima
# PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=AW-XXXXXXXXX/lead-label
# PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-XXXXXXXXX/whatsapp-label
# Bloqueia indexação em buscadores. Defina como false quando o site estiver pronto para SEO.
PUBLIC_BLOCK_INDEXING=false

# Meta (Facebook) — integração direta: Pixel + API de Conversões
# ID do Pixel/conjunto de dados (Gerenciador de Eventos)
PUBLIC_META_PIXEL_ID=
# Token da API de Conversões (somente servidor — nunca expor). Só a permissão de envio de eventos.
META_CAPI_TOKEN=
# Opcional: código de "Testar eventos" do Gerenciador de Eventos (ex.: TEST12345)
META_TEST_EVENT_CODE=
# Só para `pnpm meta:quality` (local): token separado com read_ads_dataset_quality
META_DATASET_QUALITY_TOKEN=
